# Soft IP 主诉评估系统 v4 环境配置
# 复制为 .env 后修改（.env 已在 .gitignore 中，不会进版本库）
# 配置在每次调用时读取、不缓存，改完即刻生效（不需要重启后端）

# 运行模式：True = Mock 离线演示（无需任何 Key）；False = 真实模式
# 注意：start.sh 会把 USE_MOCK 作为环境变量 export，环境变量优先级高于本文件。
USE_MOCK=True

# ============================================================
# LLM 供应商：OpenAI 兼容接口，可整体替换
# ============================================================
# 网关只依赖三件事，满足即可接：
#   1. base_url + /v1/chat/completions
#   2. Authorization: Bearer <key>
#   3. 响应体 choices[0].message.content
#
# 首选做法是**在「高级设置」页切换**（选一下即刻生效），本文件由它自动维护。
# 手写也可以：解析链是「本文件 / 环境变量显式值 > providers.py 预设 > 模块常量」。
#
# 密钥各家认各家的槽，不写在切换逻辑里：
#   DeepSeek → LLM_API_KEY（兼容旧 DEEPSEEK_API_KEY）
#   Kimi     → KIMI_API_KEY
#   OpenAI   → OPENAI_API_KEY
# 未配专属槽的供应商在界面上不可切换：避免拿别家的 key 去调，401 要等评估
# 跑到一半才炸出来。运行时若只有通用槽的一把 key，任何供应商都能跑（会告警）。

# --- 方案 A：DeepSeek（默认，取消注释即可用）---
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_STRONG_MODEL=deepseek-reasoner
LLM_FAST_MODEL=deepseek-chat
LLM_JSON_MODE_MODELS=deepseek-chat

# 生成长度上限的字段名（默认值通常不用动）
#   DeepSeek / OpenAI 用 max_tokens；Kimi 已将 max_tokens 标为弃用，
#   必须用 max_completion_tokens。填错的后果是静默的：Kimi 会忽略该字段
#   并回落到默认的 131072，而它的限流按这个值预扣额度，
#   低额度账号会在毫无征兆的情况下 429。
LLM_MAX_TOKENS_PARAM=max_tokens

# --- 方案 B：Kimi / Moonshot（用这段整段替换上面的 A 段）---
# 注意：moonshot-v1 全系列与 kimi-k2.5 已于 2026-08-31 下线，不要再填。
# 账号需先充值激活（最低 $1），否则 key 调不通。
# LLM_PROVIDER=kimi
# LLM_API_KEY=
# LLM_BASE_URL=https://api.moonshot.ai/v1
# LLM_STRONG_MODEL=kimi-k3
# LLM_FAST_MODEL=kimi-k2.6
# LLM_JSON_MODE_MODELS=kimi-k2.6
# LLM_MAX_TOKENS_PARAM=max_completion_tokens

# 关于 LLM_JSON_MODE_MODELS（换供应商时最容易漏的一项）
#   这是「哪些模型接受 response_format=json_object」的白名单。
#   换供应商后若不同步修改，请求不会报错，只是 json 模式被静默关掉，
#   退化成文本解析 + 兜底清理——输出越来越不稳定却查不出原因。
#   多个模型用英文逗号分隔，如：kimi-k2.6,kimi-k2.7-code

# ============================================================
# 外部数据源（全部可选，缺哪个就跳过哪个，不影响主流程与评分）
# ============================================================
# 企查查：被告画像 + 回款能力打分（规则计算，不经 LLM）
QCC_API_TOKEN=

# 北大法宝：法条与类案检索 + 引用真实性核验。仅用于报告增强，不参与评分
PKULAW_API_TOKEN=

# 硅基流动 bge-m3 embedding（P3 RAG 知识库启用）
SILICONFLOW_API_KEY=

# ============================================================
# 自检：填完 key 后跑一遍，确认配置 / 连通性 / 真实主流程都通
#   cd backend && python scripts/probe_real_api.py
# ============================================================
