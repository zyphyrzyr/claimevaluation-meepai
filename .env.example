# Soft IP 主诉评估系统 v4 环境配置
# 复制为 .env 后修改

# 运行模式：True = Mock 离线演示（无需任何 Key）；False = 真实模式
USE_MOCK=True

# DeepSeek LLM（真实模式必填）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 外部检索（真实模式建议填写；未填则对应链路自动跳过并标注）
QCC_API_TOKEN=
PKULAW_API_TOKEN=

# 硅基流动 bge-m3 embedding（P3 RAG 知识库启用）
SILICONFLOW_API_KEY=
